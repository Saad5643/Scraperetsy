@echo off
rem ===========================================================================
rem  Etsy Scraper - self-contained installer.
rem
rem  Everything is inside this one file. Double-click it and it will:
rem    1. unpack the app into %USERPROFILE%\etsy-scraper
rem    2. install Node.js if the PC does not have it
rem    3. install the app packages and the scraping browser
rem    4. put an "Etsy Scraper" shortcut on the Desktop, and start the app
rem
rem  Safe to run again; anything already done is skipped. Your settings and
rem  scraped files are never overwritten.
rem ===========================================================================
setlocal
title Etsy Scraper - Installer

set "DEST=%USERPROFILE%\etsy-scraper"
set "SELF=%~f0"
set "ZIP=%TEMP%\etsy-scraper-payload.zip"

echo.
echo   ======================================================
echo     Etsy Scraper - Installer
echo   ======================================================
echo.
echo   Installing to: %DEST%
echo.
echo   [1] Unpacking the app...

powershell -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; $lines=[IO.File]::ReadAllLines($env:SELF); $i=[Array]::IndexOf($lines,'#PAYLOAD#'); if($i -lt 0){throw 'payload marker missing - the file was altered in transit'}; $b64=-join $lines[($i+1)..($lines.Length-1)]; [IO.File]::WriteAllBytes($env:ZIP,[Convert]::FromBase64String($b64))"
if errorlevel 1 goto :broken
if not exist "%ZIP%" goto :broken

powershell -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; New-Item -ItemType Directory -Path $env:DEST -Force | Out-Null; Expand-Archive -LiteralPath $env:ZIP -DestinationPath $env:DEST -Force"
if errorlevel 1 goto :broken
del "%ZIP%" >nul 2>&1

if not exist "%DEST%\installer\setup.ps1" goto :broken
echo       Done.

powershell -NoProfile -ExecutionPolicy Bypass -File "%DEST%\installer\setup.ps1"
if errorlevel 1 goto :failed

echo.
echo   You can close this window.
"%SystemRoot%\System32\timeout.exe" /t 20 /nobreak >nul 2>&1
exit /b 0

:broken
echo.
echo   [X] This installer file looks damaged or incomplete.
echo       Download it again - and if your browser or email renamed it,
echo       make sure the name ends in .cmd and nothing else.
echo.
pause
exit /b 1

:failed
echo.
echo   Setup did not finish. The reason is in the messages above.
echo   Running this file again is safe and picks up where it stopped.
echo.
pause
exit /b 1

